rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;

      match /following/{targetUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /blocked/{targetUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /followers/{uid}/items/{followerUid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == followerUid && followerUid != uid;
      allow delete: if signedIn() && request.auth.uid == followerUid;
      allow update: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.likes == 0;
      allow update: if admin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.likes + 1);
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.read == false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if admin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if admin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if admin()
          || (signedIn() && resource.data.from == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
